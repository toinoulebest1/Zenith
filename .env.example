# Tidal : instance hifi-api (recherche + lecture, titres complets jusqu'à 24 bits) — valeur par défaut intégrée
# TIDAL_HIFI_BASE=http://...sslip.io
# Qualité demandée : HI_RES_LOSSLESS (descend toute seule en LOSSLESS si le titre n'a pas mieux)
# TIDAL_QUALITY=HI_RES_LOSSLESS

# Addon Eljohnzc (secours Tidal) — valeurs par défaut intégrées, à décommenter pour changer
# ELJOHNZC_BASE=https://eljohnzcaddon.velixir.run/c57e7b0ef2031b2f1fcd
# Qualité : hires | lossless | high | low
# ELJOHNZC_QUALITY=hires

# Monochrome (source « Tidal » : recherche + FLAC lu par le navigateur) — valeur par défaut intégrée
# MONO_BASE=https://tracks.monochrome.st

# Paroles synchronisées mot à mot (lrc.red). Leurs conditions demandent de s'identifier :
# URL publique du site + e-mail de contact (envoyés dans le User-Agent de chaque requête).
LRCRED_SITE=
LRCRED_CONTACT=

# Tidal OAuth
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Qobuz (actif dès que QOBUZ_TOKEN est renseigné ; QOBUZ_ENABLED=0 pour le couper)
QOBUZ_TOKEN=
QOBUZ_USER_ID=
# Facultatifs (valeurs par défaut intégrées, liées au token)
# QOBUZ_APP_ID=
# QOBUZ_SECRET=

# Deezer : cookie « arl » du compte (deezer.com → outils de développement → Cookies).
# Lecture complète en FLAC si l'abonnement le permet, sinon MP3. Ne jamais le publier.
DEEZER_ARL=
