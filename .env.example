# Addon Eljohnzc (recherche + lecture Tidal) — valeurs par défaut intégrées, à décommenter pour changer
# ELJOHNZC_BASE=https://eljohnzcaddon.velixir.run/c57e7b0ef2031b2f1fcd
# Qualité : hires | lossless | high | low
# ELJOHNZC_QUALITY=hires

# Paroles synchronisées mot à mot (lrc.red). Leurs conditions demandent de s'identifier :
# URL publique du site + e-mail de contact (envoyés dans le User-Agent de chaque requête).
LRCRED_SITE=
LRCRED_CONTACT=

# Tidal OAuth
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Qobuz (actif dès que QOBUZ_TOKEN est renseigné ; QOBUZ_ENABLED=0 pour le couper)
QOBUZ_TOKEN=
QOBUZ_USER_ID=
# Facultatifs (valeurs par défaut intégrées, liées au token)
# QOBUZ_APP_ID=
# QOBUZ_SECRET=
